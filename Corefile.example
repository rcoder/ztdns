# Example Corefile for ztdns plugin
# Copy this to Corefile and customize for your setup

lab.zt. {
    bind ztw4lkuuz6
    debug
    log
    ztdns {
        token {$ZT_API_TOKEN}
        network {$ZT_NETWORK_ID}
        refresh 60s
    }
    errors
}

# Forward all other queries to upstream DNS
. {
    bind enp191s0
    forward . 1.1.1.1
    log
    errors
    cache 30
}
